cc_library_headers {
    name: "ccci_headers",
    export_include_dirs: ["include"],
    proprietary: true,
}

cc_library_shared {
    name: "libccci_util",
    srcs: [
        "ccci_lib.c",
        "platform/ccci_lib_platform.c",
    ],
    local_include_dirs: [
        "platform",
    ],
    export_include_dirs: [
        "include",
    ],
    proprietary: true,
    owner: "mtk",
    shared_libs: [
        "libc",
        "liblog",
    ],
    static_libs: [
        "libcutils",
    ],
    defaults: ["mtk_ccci_util_defaults"],
}

bootstrap_go_package {
    name: "soong-ccci-mediatek",
    pkgPath: "android/soong/ccci/mediatek",
    deps: [
        "soong-android",
        "soong-cc",
    ],
    srcs: [
        "ccci.go",
    ],
    pluginFor: ["soong_build"],
}

mtk_ccci_util_defaults {
    name: "mtk_ccci_util_defaults",
}
